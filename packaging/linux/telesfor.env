# Restart with `systemctl restart telesfor` after editing. Settings:
# https://github.com/combor/telesfor/blob/main/docs/usage.md#configuration

# Outside Poland: an HTTP proxy with a Polish exit.
#TELESFOR_TVP_PROXY=http://<proxy-host>:<port>

# Outside Brazil: an HTTP proxy with a Brazilian exit.
#TELESFOR_GLOBO_PROXY=http://<proxy-host>:<port>

# Only if EBC or TV Cultura block their streams outside Brazil: the same kind
# of proxy.
#TELESFOR_EBC_PROXY=http://<proxy-host>:<port>
#TELESFOR_CULTURA_PROXY=http://<proxy-host>:<port>

#TELESFOR_LISTEN=:5004
#TELESFOR_DEBUG=1
